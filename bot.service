[Unit]
Description=Telegram OCR Lecture Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/telegram-ocr-bot
ExecStart=/opt/telegram-ocr-bot/venv/bin/python main.py
Restart=always
RestartSec=10
EnvironmentFile=/opt/telegram-ocr-bot/.env

[Install]
WantedBy=multi-user.target
